{$DOMAIN:localhost} {
	encode gzip
	request_body {
		max_size 520MB
	}

	reverse_proxy /api/* api:3001 {
		flush_interval -1
		transport http {
			dial_timeout 30s
			read_timeout 30m
			write_timeout 30m
		}
	}

	reverse_proxy /media/* api:3001 {
		flush_interval -1
		transport http {
			dial_timeout 30s
			read_timeout 30m
			write_timeout 30m
		}
	}

	reverse_proxy web:3000
}
