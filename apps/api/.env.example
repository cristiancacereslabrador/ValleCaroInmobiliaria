# Puerto HTTP de la API NestJS
PORT=3001

# Conexion a MariaDB (docker-compose.yml expone el servicio "mariadb" en el
# puerto host 3307 para no colisionar con un MariaDB ya existente en el host)
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=real_estate
DB_PASSWORD=real_estate
DB_DATABASE=real_estate

# Google Maps - Geocoding API + Places API (Nearby Search) (clave de
# servidor, restringida a Geocoding API y Places API, NUNCA se expone al
# cliente). neighborhood-market-insights (design.md - Decision 1) reutiliza
# la misma clave/proyecto de Geocoding, ampliando su restriccion de API en
# Google Cloud Console para incluir tambien Places API.
GOOGLE_MAPS_SERVER_API_KEY=

# nearby-services: radio de busqueda (en metros) para colegios, transporte y
# supermercados alrededor de una propiedad (design.md - Decision 1)
NEARBY_SERVICES_RADIUS_METERS=1000

# price-trends: numero minimo de propiedades distintas con historico de
# precio en una zona (ciudad + codigo postal) antes de devolver una serie de
# evolucion de precio, para evitar tendencias poco representativas
# (design.md - Decision 3)
PRICE_TREND_MIN_PROPERTIES=3

# Limites de subida de medios (property-media)
MEDIA_MAX_IMAGE_SIZE_MB=10
MEDIA_MAX_VIDEO_SIZE_MB=100

# Directorio de almacenamiento local de medios (relativo a apps/api)
MEDIA_STORAGE_PATH=storage/properties

# Staff inicial (se crea al arrancar si no hay usuarios)
BROKER_EMAIL=broker@local.test
BROKER_PASSWORD=changeme123
BROKER_NAME=Asesor
BROKER_DEFAULT_NAME=ValleCaro Inmobiliaria
JWT_SECRET=dev-only-change-me

# Orígenes del frontend (cookies + CORS). Separados por coma.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# saved-search-alerts: SMTP (Nodemailer, design.md - Decision 2). En
# desarrollo local, apuntar a un servidor de pruebas tipo MailHog
# (puerto SMTP habitual 1025, UI web en :8025) - nunca credenciales reales.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@real-estate-platform.test

# saved-search-alerts: URL base publica del frontend, usada para construir
# los enlaces de confirmacion/baja incluidos en los emails
WEB_BASE_URL=http://localhost:3000

# saved-search-alerts: plazo maximo (horas) para confirmar una alerta antes
# de que su enlace de confirmacion expire (spec.md, Requirement
# "Confirmacion de la alerta por email")
ALERT_CONFIRMATION_TTL_HOURS=48

# saved-search-alerts: mitigacion de abuso (design.md - Decision 4) - limite
# de alertas creadas por IP en la ventana indicada...
ALERT_RATE_LIMIT_IP_MAX=5
ALERT_RATE_LIMIT_IP_WINDOW_HOURS=1

# ...y maximo de alertas activas/pendientes simultaneas por email
ALERT_RATE_LIMIT_EMAIL_MAX_ACTIVE=10

# property-valuation-estimator: numero minimo de propiedades comparables
# (mismo tipo/zona/superficie +-25%/habitaciones +-1) antes de devolver un
# rango de precio estimado, para evitar estimaciones poco fiables
# (design.md - Decision 3, mismo criterio que PRICE_TREND_MIN_PROPERTIES)
VALUATION_ESTIMATOR_MIN_COMPARABLES=3
