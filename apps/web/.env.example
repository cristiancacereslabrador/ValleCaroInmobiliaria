# URL base de la API backend (apps/api), incluyendo el prefijo /api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Clave de Google Maps JavaScript API restringida por referer/dominio
# (se expone al navegador - separada de GOOGLE_MAPS_SERVER_API_KEY del
# backend, ver apps/api/.env.example y design.md - Decision 5). Si se deja
# vacia, el frontend sigue funcionando pero sin mapas (ver
# property-geolocation spec - "Manejo de error del servicio de Google Maps").
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
